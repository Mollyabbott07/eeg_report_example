


@article{kutas1980,
	title = {Reading {Senseless} {Sentences}: {Brain} {Potentials} {Reflect} {Semantic} {Incongruity}},
	volume = {207},
	issn = {0036-8075, 1095-9203},
	shorttitle = {Reading {Senseless} {Sentences}},
	url = {https://www.science.org/doi/10.1126/science.7350657},
	doi = {10.1126/science.7350657},
	abstract = {In a sentence reading task, words that occurred out of context were associated with specific types of event-related brain potentials. Words that were physically aberrant (larger than normal) elicited a late positive series of potentials, whereas semantically inappropriate words elicited a late negative wave (N400). The N400 wave may be an electrophysiological sign of the "reprocessing" of semantically anomalous information.},
	language = {en},
	number = {4427},
	urldate = {2026-10-28},
	journal = {Science},
	author = {Kutas, Marta and Hillyard, Steven A.},
	month = jan,
	year = {1980},
	pages = {203--205},
}

